# 复制为 .env.local 后填写（.env.local 已在 .gitignore 中，不会被提交）
#
# 必填：DeepSeek API Key（也兼容任何 OpenAI 兼容网关）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：网关地址与模型
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Agent Runtime 可调参数（不填则用默认值）----
# 单轮用户输入内最多允许多少次「LLM 调用 -> 工具执行」迭代
MINI_AGENT_MAX_STEPS=6
# 上下文预算（估算 token），超过则触发压缩
MINI_AGENT_MAX_CONTEXT_TOKENS=6000
# 压缩时保留的最近完整轮数（1 轮 = 1 条 user 消息及其后续）
MINI_AGENT_KEEP_RECENT_TURNS=4
# 单个工具执行超时（毫秒）
MINI_AGENT_TOOL_TIMEOUT_MS=5000
# 单条工具结果写入上下文前的最大字符数
MINI_AGENT_MAX_TOOL_RESULT_CHARS=2000
# 采样温度
MINI_AGENT_TEMPERATURE=0.3
# trace 日志目录（JSONL）
MINI_AGENT_LOG_DIR=logs
# 是否把 trace 同时打印到控制台：true/false
MINI_AGENT_TRACE_CONSOLE=false
